{
  "uid": "telemetry-overview",
  "title": "Telemetry overview",
  "tags": [
    "telemetry"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Temperature per device",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influx-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-telemetry"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"uplink\" and r._field == \"temperature_c\")\n  |> keep(columns: [\"_time\", \"_value\", \"device\"])\n  |> group(columns: [\"device\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "RSSI per device",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "pg-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "pg-telemetry"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT u.received_at AS time, d.name AS metric, u.rssi AS value\nFROM uplinks u JOIN devices d USING (dev_eui)\nWHERE $__timeFilter(u.received_at) AND u.rssi IS NOT NULL\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dBm",
          "custom": {
            "drawStyle": "points",
            "lineWidth": 1,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Uplinks per hour",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "pg-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "pg-telemetry"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('hour', u.received_at) AS time, d.name AS metric, COUNT(*) AS value\nFROM uplinks u JOIN devices d USING (dev_eui)\nWHERE $__timeFilter(u.received_at)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 3
    },
    {
      "type": "table",
      "title": "Frame counter gaps",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "postgres",
        "uid": "pg-telemetry"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "pg-telemetry"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH s AS (\n  SELECT d.name AS device, u.received_at, u.f_cnt,\n         u.f_cnt - LAG(u.f_cnt) OVER (PARTITION BY u.dev_eui ORDER BY u.received_at, u.f_cnt) AS step\n  FROM uplinks u JOIN devices d USING (dev_eui)\n  WHERE $__timeFilter(u.received_at)\n)\nSELECT device, received_at AS \"received after the gap\", f_cnt - step + 1 AS \"first missing fCnt\",\n       f_cnt - 1 AS \"last missing fCnt\", step - 1 AS \"missing frames\"\nFROM s WHERE step > 1 ORDER BY received_at"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 4
    }
  ]
}
